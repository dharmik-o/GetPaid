# Copy this file to a local env file and fill in the values. Never commit the real one.
# Values below are local-dev placeholders only.

# Postgres container (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=payment_recovery

# Postgres connection for the dashboard and `npm run db:*` (must match the values above)
DATABASE_URL=postgres://postgres:change-me-local-only@localhost:5432/payment_recovery

# Encrypts API keys and OAuth tokens at rest (apps/web/src/lib/crypto.ts).
# 32 bytes as 64 hex characters or base64. Generate with: openssl rand -hex 32
# Changing it makes every stored secret unreadable; users would have to enter them again.
ENCRYPTION_KEY=

# n8n: encrypts credentials stored in n8n. Generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# LiteLLM gateway admin key; clients send it as the Bearer token. Must start with "sk-".
LITELLM_MASTER_KEY=

# PayPal REST app, SANDBOX only (developer.paypal.com > Apps & Credentials > Sandbox).
# The app always calls api-m.sandbox.paypal.com; live credentials won't work there.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The sandbox webhook's id (shown after you add the webhook URL in the same app); verifies webhooks.
PAYPAL_WEBHOOK_ID=

# n8n calls the app's internal routes (the AI router) with this token, as a Bearer header.
# Put the same value in the n8n credential "App internal API token" (Header Auth:
# name Authorization, value "Bearer <token>"). Generate with: openssl rand -hex 32
INTERNAL_API_TOKEN=

# Optional: your Telegram bot's username (from @BotFather), for the Connect Telegram link. The
# bot's token isn't set here: it goes in the n8n credential "Telegram bot", and the app never sees it.
TELEGRAM_BOT_USERNAME=

# Google OAuth client for Gmail (steps in docs/NEEDS_YOU.md). The redirect URI to register is
# http://localhost:3000/api/integrations/gmail/callback . The refresh token is encrypted in the database.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# The only addresses real Gmail sends may go to in dev, comma-separated. Empty means nothing sends:
# anything else is refused and logged, and the reminder stays held.
DEV_EMAIL_ALLOWLIST=

# Optional: where the app finds the local model runner (Ollama), to check it and download models
# from Settings > AI. In production (docker-compose.prod.yml) it is http://ollama:11434.
LOCAL_AI_URL=http://127.0.0.1:11434

# Optional: a built-in AI model for everyone who hasn't saved their own in Settings > AI.
# The key stays on the server: users see only the provider and model name, never the key.
# AI_DEFAULT_PROVIDER is a preset id: gemini, claude, openai, groq, openrouter, ollama, lmstudio
# or custom. AI_DEFAULT_BASE_URL is only needed for custom (it defaults to the preset's URL).
# For example: AI_DEFAULT_PROVIDER=gemini and AI_DEFAULT_MODEL=gemini-3.5-flash-lite
AI_DEFAULT_PROVIDER=
AI_DEFAULT_MODEL=
AI_DEFAULT_API_KEY=
AI_DEFAULT_BASE_URL=

# Optional: the dashboard's address, for links in Telegram messages. Left empty, they name the Outbox.
APP_PUBLIC_URL=

# Optional: the public HTTPS address of n8n (a tunnel in development), for Telegram and PayPal webhooks.
# For example https://your-tunnel.example/ . Left empty, n8n uses http://localhost:5678/.
WEBHOOK_URL=

# Optional: the folder every invoice PDF sent to a client is saved in, by client and project. It holds
# client data, so back it up, and keep it outside any git repository: the app refuses one inside, unless
# it's in a folder named invoice-archive. Left empty, it's Documents/GetPaid/Invoices in your home folder.
INVOICE_ARCHIVE_DIR=

# Optional, development only: moves the app's clock this many days ahead, for the demo
# (docs/DEMO.md). Part of a day works. Settings has a control for jumping without a restart.
# Ignored in production.
# DEMO_CLOCK_OFFSET_DAYS=0

# Optional, development only: which local user the dashboard acts as until real sign-in exists.
# Leave unset to use the demo freelancer from `npm run db:seed`.
# DEV_USER_ID=00000000-0000-4000-8000-000000000001

# --- Production / public demo (docker-compose.prod.yml), set on the server only ---

# The public address Caddy serves, without https://. A free DuckDNS name works, for example
# getpaid-demo.duckdns.org. With DOMAIN=localhost you can try the production stack on one machine.
# Also set APP_PUBLIC_URL=https://<domain> and WEBHOOK_URL=https://<domain>/ above.
DOMAIN=

# Makes every plain `docker compose` command use the production files. Set it on the server only
# (on Windows the separator is a semicolon).
# COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml

# The public demo gate (decision E7). With DEMO_MODE=true in production, the seeded demo freelancer
# can use the dashboard behind a password page. Without it, production refuses to start.
# DEMO_USERNAME: the sign-in name (admin if empty). DEMO_PASSWORD: 8 characters or more; put it in
# single quotes if it starts with # or has spaces, for example DEMO_PASSWORD='#abc...'.
# DEMO_COOKIE_SECRET: 32 or more, openssl rand -hex 32.
DEMO_MODE=false
DEMO_USERNAME=
DEMO_PASSWORD=
DEMO_COOKIE_SECRET=

# Phase 2: how often imported calendars refresh, in minutes (min 15).
CALENDAR_SYNC_MINUTES=30
