{
  "name": "Reply listener: sorts client replies and pauses or branches",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "2d7a6c10-0501-4f3b-8a2e-000000000501",
      "name": "Every 5 minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:3000/api/internal/replies/run",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({}) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true
            }
          },
          "timeout": 280000
        }
      },
      "id": "2d7a6c10-0502-4f3b-8a2e-000000000502",
      "name": "Read replies in the app",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        260,
        0
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "app-internal-api-token",
          "name": "App internal API token"
        }
      },
      "notes": "The app reads only the thread IDs it stored when sending, sorts each new reply through the AI router, and holds the invoice until the freelancer decides. Safe to re-run: each reply is handled once. The reply card goes out from Approval handler's one-minute run."
    }
  ],
  "connections": {
    "Every 5 minutes": {
      "main": [
        [
          {
            "node": "Read replies in the app",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "active": false
}
