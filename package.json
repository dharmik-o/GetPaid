{
  "name": "freelancer-payment-recovery",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace web",
    "test": "vitest run",
    "test:db:docker": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.docker.config.ts",
    "test:paypal:sandbox": "node --env-file-if-exists=.env node_modules/vitest/vitest.mjs run --config vitest.sandbox.config.ts",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p apps/web",
    "check": "npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "env:check": "tsx --env-file-if-exists=.env scripts/env-check.ts",
    "db:dev-auth": "tsx --env-file-if-exists=.env scripts/db.ts dev-auth",
    "db:migrate": "tsx --env-file-if-exists=.env scripts/db.ts migrate",
    "db:seed": "tsx --env-file-if-exists=.env scripts/db.ts seed"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.14",
    "@eslint/js": "^10.0.1",
    "@next/eslint-plugin-next": "^16.4.4",
    "@playwright/test": "^1.64.1",
    "@types/luxon": "^3.7.6",
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "msw": "^3.0.3",
    "pg": "^8.23.1",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.1.0",
    "yaml": "^2.9.1"
  }
}
