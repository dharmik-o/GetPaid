{
  "$comment": "Generated from apps/web/src/lib/ai-schemas.ts (calendarAnswerSchema); tests/ai-schemas.test.ts keeps them identical.",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "answer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1500
    },
    "references": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 80
      }
    },
    "proposals": {
      "maxItems": 10,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "move"
              },
              "key": {
                "type": "string",
                "maxLength": 80
              },
              "startsOn": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "startTime": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{2}:\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endTime": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{2}:\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "op",
              "key",
              "startsOn",
              "startTime",
              "endTime",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "create"
              },
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "type": "string",
                "enum": [
                  "task",
                  "event",
                  "deadline",
                  "call"
                ]
              },
              "startsOn": {
                "type": "string",
                "format": "date",
                "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
              },
              "startTime": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{2}:\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "endTime": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^\\d{2}:\\d{2}$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "clientName": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 120
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "op",
              "title",
              "kind",
              "startsOn",
              "startTime",
              "endTime",
              "clientName",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "mark_done"
              },
              "key": {
                "type": "string",
                "maxLength": 80
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "op",
              "key",
              "reason"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "op": {
                "type": "string",
                "const": "delete"
              },
              "key": {
                "type": "string",
                "maxLength": 80
              },
              "reason": {
                "type": "string",
                "maxLength": 200
              }
            },
            "required": [
              "op",
              "key",
              "reason"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "answer",
    "references",
    "proposals"
  ],
  "additionalProperties": false
}
